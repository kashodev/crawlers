# Copy to .env and fill in. Every value is optional: with an empty .env the
# crawler runs fully locally, writing PDFs to data/ and metadata to data/_metadata.
# Setting the GCP values switches the same image over to Cloud Storage + Firestore.

# --- GCP project / auth -------------------------------------------------
GOOGLE_CLOUD_PROJECT=
# Path to a service-account key. Leave blank on Cloud Run, which uses the
# job's attached service account via Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage ------------------------------------------------------------
# Setting PDF_BUCKET switches the storage backend from local disk to GCS.
PDF_BUCKET=
PDF_PREFIX=
# gs:// URI to load site YAML from instead of the local file.
CONFIG_BUCKET=

# --- Firestore ----------------------------------------------------------
# Setting FIRESTORE_PROJECT switches metadata from local JSON to Firestore.
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)

# --- Crawler behaviour --------------------------------------------------
# Identify yourself honestly; public-sector sites block anonymous crawlers.
CRAWLER_USER_AGENT=pdf-research-crawler/1.0 (+RAG test-data collection; contact: you@example.com)
# Seconds between requests to one host. Raise it, never lower it below ~0.5.
CRAWLER_MIN_DELAY=1.0
# Cap documents per run; useful for smoke tests. Blank means no cap.
CRAWLER_MAX_DOCUMENTS=
LOG_LEVEL=INFO
